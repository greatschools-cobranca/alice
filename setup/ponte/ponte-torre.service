[Unit]
Description=Ponte de saída da Alice (container isolado previamente preparado)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
# Não habilitar esta unidade antes de concluir a homologação do README.

[Service]
Type=simple
ExecStart=/usr/bin/docker start --attach alice-torre-bridge
ExecStop=/usr/bin/docker stop --time 20 alice-torre-bridge
Restart=on-failure
RestartSec=15
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
