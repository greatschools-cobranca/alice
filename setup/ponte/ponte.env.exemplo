# Opcionais
# POLL_MS=3000            intervalo entre consultas à Torre (ms)
# MAX_CONCURRENT=2        pedidos atendidos ao mesmo tempo
# CHAT_TIMEOUT_MS=600000  tempo máximo de uma resposta da conversa (ms)
